<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Suite" parallel="tests" thread-count="2">
    <listeners>
        <listener class-name="core.TestListener"/>
    </listeners>
    <parameter name="browser" value="chrome"/>

    <test name="Auth - Login Basic Auth">
        <classes>
            <class name="user.LoginPageTest"/>
        </classes>
    </test>

    <test name="Navbar - Navbar Menu Button">
        <classes>
            <class name="user.NavbarMenuTest"/>
        </classes>
    </test>

</suite>